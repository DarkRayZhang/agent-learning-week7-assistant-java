# ============================================================
# Assistant Java —— 凭据模板
# ============================================================
# 用法：复制成 `.env`（与 pom.xml 同级），把值填上。
#        .env 已被 .gitignore 忽略；**不要**把真实 Key 提交进仓库。
#
#   cp .env.example .env    # Git Bash
#   copy .env.example .env  # CMD
#
# ⚠️ 本项目需要**两家厂商**的凭据，别只填一半：
#     · chat       → DeepSeek（走 OpenAI 兼容协议）
#     · embedding  → 阿里云百炼
#   原因（W5 实测的硬事实）：**DeepSeek 官方 API 没有 `/embeddings` 端点**（打过去 404）。
#   → 两套 Key、两条 base-url，配置里就是这么分的。
# ============================================================

# ── 对话模型（DeepSeek）──────────────────────────────────
# 去 https://platform.deepseek.com 注册 → 充值 → API keys 创建
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI 兼容端点（**只换 base-url 即可**，协议还是 OpenAI 的）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 以控制台实际存在的模型名为准
MODEL_NAME=deepseek-v4-flash

# ── 向量化 / Embedding（阿里云百炼）────────────────────────
# 去 https://bailian.console.aliyun.com 开通 → API-KEY 管理
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
